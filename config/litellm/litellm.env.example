# Copy to ~/.config/litellm/litellm.env on the target host.
# Do not commit real keys.

# Required by LiteLLM proxy auth. The bootstrap script can generate one.
LITELLM_MASTER_KEY=sk-change-me

# GitHub Copilot and ChatGPT subscription providers use OAuth device flow.
# No upstream API key is required in this file for the default config.yaml.
# On first model call for each provider, check LiteLLM logs for the device login URL/code.
