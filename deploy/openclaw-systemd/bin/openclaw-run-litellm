#!/usr/bin/env bash
set -euo pipefail

exec /usr/bin/podman run --rm \
  --name openclaw-litellm \
  --pod openclaw \
  -e LITELLM_MASTER_KEY \
  -e OPENAI_API_KEY \
  -e ANTHROPIC_API_KEY \
  -e AZURE_API_KEY \
  -e AZURE_API_BASE \
  -e AZURE_API_VERSION \
  -e GITHUB_COPILOT_TOKEN_DIR=/data/github_copilot \
  -e CHATGPT_TOKEN_DIR=/data/chatgpt \
  -v "${HOME}/.config/litellm/config.yaml:/app/config.yaml:Z" \
  -v "${HOME}/.local/share/litellm:/data:Z" \
  docker.litellm.ai/berriai/litellm:main-v1.82.3@sha256:067aee932b8770ed42955ee802a04abdcd369d0995b5e696bb07d6520a231b1c \
  --config /app/config.yaml --port 4000 --host 0.0.0.0
