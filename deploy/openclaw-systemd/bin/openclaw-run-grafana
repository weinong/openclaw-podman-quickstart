#!/usr/bin/env bash
set -euo pipefail

exec /usr/bin/podman run --rm \
  --name openclaw-grafana \
  --pod openclaw-observability \
  --user 0:0 \
  -e GF_SECURITY_ADMIN_USER \
  -e GF_SECURITY_ADMIN_PASSWORD \
  -e GF_SERVER_HTTP_ADDR=0.0.0.0 \
  -e GF_SERVER_HTTP_PORT=3000 \
  -e GF_AUTH_ANONYMOUS_ENABLED=false \
  -v "${HOME}/.config/openclaw-observability/grafana/provisioning:/etc/grafana/provisioning:ro,Z" \
  -v "${HOME}/.config/openclaw-observability/grafana/dashboards:/etc/grafana/dashboards:ro,Z" \
  -v "${HOME}/.local/share/openclaw-observability/grafana:/var/lib/grafana:Z" \
  __GRAFANA_IMAGE__
