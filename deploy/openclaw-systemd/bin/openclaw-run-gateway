#!/usr/bin/env bash
set -euo pipefail

exec /usr/bin/podman run --rm \
  --name openclaw-gateway \
  --pod openclaw \
  --log-driver=k8s-file \
  --user 0:0 \
  --env-file "${HOME}/.config/openclaw-gateway/gateway.env" \
  -e HOME=/home/node \
  -e OPENCLAW_HOME=/home/node/.openclaw \
  -e OPENCLAW_CONFIG_PATH=/home/node/.openclaw/openclaw.json \
  -e OPENCLAW_DISABLE_BONJOUR=1 \
  -e NO_COLOR=1 \
  -v "${HOME}/.openclaw:/home/node/.openclaw:Z" \
  -v "${HOME}/.openclaw/openclaw.json:/home/node/.openclaw/openclaw.json:ro,Z" \
  -v "${HOME}/openclaw-workspace:/home/node/openclaw-workspace:Z" \
  __OPENCLAW_GATEWAY_IMAGE__
