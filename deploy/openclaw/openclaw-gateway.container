[Unit]
Description=OpenClaw gateway container
After=openclaw-pod.service openclaw-browser.service litellm.service searxng.service
Requires=openclaw-pod.service openclaw-browser.service litellm.service searxng.service

[Container]
Pod=openclaw.pod
Image=ghcr.io/openclaw/openclaw:2026.4.24@sha256:7c4370ff8777555d4c9fe5ab821aaaad7c87188d389a6cf761270725d96ec3e9
ContainerName=openclaw-gateway
Volume=%h/.openclaw:/home/node/.openclaw:Z
Volume=%h/.openclaw/workspace:/home/node/.openclaw/workspace:Z
EnvironmentFile=%h/.config/openclaw-gateway/gateway.env
Environment=OPENCLAW_HOME=/home/node/.openclaw
Environment=OPENCLAW_CONFIG_PATH=/home/node/.openclaw/openclaw.json
Environment=NO_COLOR=1

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=300

[Install]
WantedBy=default.target
