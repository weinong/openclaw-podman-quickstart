[Unit]
Description=Grafana Alloy log collector for OpenClaw observability
After=openclaw-observability-pod.service loki.service
Requires=openclaw-observability-pod.service loki.service

[Container]
Pod=openclaw-observability.pod
Image=__ALLOY_IMAGE__
ContainerName=openclaw-alloy
User=0:0
Volume=%h/.config/openclaw-observability/alloy.alloy:/etc/alloy/config.alloy:ro,Z
Volume=%h/.local/share/containers/storage/overlay-containers:/var/lib/containers/storage/overlay-containers:ro
Volume=%h/.local/share/openclaw-observability/alloy:/var/lib/alloy:Z
Exec=run --server.http.listen-addr=0.0.0.0:12345 --storage.path=/var/lib/alloy /etc/alloy/config.alloy

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=300

[Install]
WantedBy=default.target
