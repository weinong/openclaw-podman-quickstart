[Unit]
Description=SearXNG search sidecar for OpenClaw
After=openclaw-pod.service
Requires=openclaw-pod.service

[Container]
Pod=openclaw.pod
Image=docker.io/searxng/searxng:2026.4.24-a7ac696b4@sha256:c9100c29c14a77d5289263a671580226c3b8a396a1a0130d2f500f57076a0119
ContainerName=openclaw-searxng
Environment=SEARXNG_BASE_URL=http://127.0.0.1:8080/
Environment=UWSGI_WORKERS=4
Environment=UWSGI_THREADS=4
User=0:0
Volume=%h/.config/searxng:/etc/searxng:Z

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=300

[Install]
WantedBy=default.target
