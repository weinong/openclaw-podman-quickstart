[Unit]
Description=SearXNG search sidecar for OpenClaw
After=openclaw-pod.service
Requires=openclaw-pod.service

[Container]
Pod=openclaw.pod
Image=__SEARXNG_IMAGE__
ContainerName=openclaw-searxng
Environment=SEARXNG_BASE_URL=http://127.0.0.1:8080/
Environment=UWSGI_WORKERS=4
Environment=UWSGI_THREADS=4
User=0:0
Volume=%h/.config/searxng/settings.yml:/etc/searxng/settings.yml:ro,Z

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=300

[Install]
WantedBy=default.target
