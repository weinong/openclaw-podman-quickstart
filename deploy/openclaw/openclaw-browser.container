[Unit]
Description=Persistent Chromium CDP browser for OpenClaw
After=openclaw-pod.service
Requires=openclaw-pod.service

[Container]
Pod=openclaw.pod
Image=__OPENCLAW_BROWSER_IMAGE__
ContainerName=openclaw-browser
ShmSize=2g
Volume=%h/.local/share/openclaw-browser:/data:Z
PodmanArgs=--init --log-driver=k8s-file

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=300

[Install]
WantedBy=default.target
