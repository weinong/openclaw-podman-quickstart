[Unit]
Description=LiteLLM proxy sidecar for OpenClaw
After=openclaw-pod.service
Requires=openclaw-pod.service

[Container]
Pod=openclaw.pod
Image=docker.litellm.ai/berriai/litellm:main-v1.82.3@sha256:067aee932b8770ed42955ee802a04abdcd369d0995b5e696bb07d6520a231b1c
ContainerName=openclaw-litellm
EnvironmentFile=%h/.config/litellm/litellm.env
Environment=GITHUB_COPILOT_TOKEN_DIR=/data/github_copilot
Environment=CHATGPT_TOKEN_DIR=/data/chatgpt
Volume=%h/.config/litellm/config.yaml:/app/config.yaml:Z
Volume=%h/.local/share/litellm:/data:Z
Exec=--config /app/config.yaml --port 4000 --host 0.0.0.0

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=300

[Install]
WantedBy=default.target
