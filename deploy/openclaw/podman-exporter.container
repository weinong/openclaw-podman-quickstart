[Unit]
Description=Podman metrics exporter for OpenClaw observability
After=openclaw-observability-pod.service podman.socket
Requires=openclaw-observability-pod.service podman.socket

[Container]
Pod=openclaw-observability.pod
Image=__PODMAN_EXPORTER_IMAGE__
ContainerName=openclaw-podman-exporter
Environment=CONTAINER_HOST=unix:///run/podman/podman.sock
Volume=%t/podman/podman.sock:/run/podman/podman.sock:ro
PodmanArgs=--security-opt label=disable
Exec=--collector.enable-all --collector.enhance-metrics --web.listen-address=:9882

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=300

[Install]
WantedBy=default.target
